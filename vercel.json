{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/valorant/:path*",
      "destination": "/api/valorant"
    },
    {
      "source": "/api/auth/discord/callback",
      "destination": "/api/auth/discord/callback"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
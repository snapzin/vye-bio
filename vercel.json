{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/auth/discord/callback.ts": {
      "includeFiles": "api/auth/jwt.ts",
      "maxDuration": 30
    },
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/valorant/(.*)",
      "destination": "/api/valorant.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

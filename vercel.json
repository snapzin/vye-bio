{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/auth/discord/callback.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 30
    },
    "api/auth/index.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 30
    },
    "api/auth/discord.ts": {
      "maxDuration": 30
    },
    "api/data/index.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 30
    },
    "api/admin/index.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 30
    },
    "api/valorant.ts": {
      "maxDuration": 30
    },
    "api/discord.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/valorant/(.*)",
      "destination": "/api/valorant.ts"
    },
    {
      "source": "/api/discord",
      "destination": "/api/discord.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

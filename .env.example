# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Supabase para Serverless Functions (sem prefixo VITE_)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-publishable-key"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Henrik Dev API
VITE_HENRIKDEV_KEY="your-henrik-api-key"

# MisticPay Configuration
VITE_MISTICPAY_CLIENT_ID=
VITE_MISTICPAY_CLIENT_SECRET=

# Discord OAuth Configuration (Frontend)
VITE_DISCORD_CLIENT_ID="your-discord-client-id"
VITE_DISCORD_CLIENT_SECRET="your-discord-client-secret"
VITE_DISCORD_REDIRECT_URI="https://your-domain.vercel.app/api/auth/discord/callback"

# Discord OAuth Configuration (Serverless Functions)
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_REDIRECT_URI="https://your-domain.vercel.app/api/auth/discord/callback"

# JWT Secret (IMPORTANTE: Use uma chave forte em produção)
# Gere uma chave segura com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_JWT_SECRET="your-jwt-secret-here"
JWT_SECRET="your-jwt-secret-here"

# VisionWallet API
VITE_VISIONWALLET_API_KEY=your-visionwallet-api-key
